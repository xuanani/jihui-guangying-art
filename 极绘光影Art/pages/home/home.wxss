/* pages/home/home.wxss */
.home-container {
  min-height: 100vh;
  background: #ffffff;
}

/* 顶部信息栏 */
.top-bar {
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.top-bar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 192rpx;
  padding: 0 32rpx;
}

.top-bar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

.top-bar-actions {
  display: flex;
  gap: 48rpx;
  align-items: center;
}

.message-icon {
  position: relative;
}

.message-icon::after {
  content: '';
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 24rpx;
  height: 24rpx;
  background: #FF4757;
  border-radius: 50%;
  border: 4rpx solid #ffffff;
}

/* 作品列表 */
.artwork-list {
  height: 100vh;
  padding-top: 200rpx;
  padding-bottom: 32rpx;
  padding-left: 0;
  padding-right: 0;
}

.artwork-content {
  padding: 0 32rpx;
}

.artwork-item {
  background: #ffffff;
  border-radius: 24rpx;
  margin-bottom: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
}

.artwork-item:active {
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

/* 用户信息 */
.user-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.user-details {
  margin-left: 24rpx;
  flex: 1;
}

.username {
  font-size: 28rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.create-time {
  font-size: 24rpx;
  color: #999999;
}

/* 作品图片 */
.artwork-image {
  width: 100%;
  height: 400rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  overflow: hidden;
  display: block;
  margin-left: auto;
  margin-right: auto;
}

/* 提示词 */
.prompt {
  margin-bottom: 24rpx;
}

.prompt-text {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 操作按钮 */
.actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.action-group {
  display: flex;
  gap: 48rpx;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0;
}

.action-item.liked {
  animation: heartBeat 0.6s ease-in-out;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.action-text {
  font-size: 24rpx;
  color: #999999;
}

.collect-btn {
  padding: 16rpx;
  border-radius: 50%;
  transition: all 0.3s ease;
}

.collect-btn.collected {
  background: rgba(0, 82, 217, 0.1);
  animation: bounceIn 0.6s ease-in-out;
}

@keyframes bounceIn {
  0% { transform: scale(0.3); opacity: 0; }
  50% { transform: scale(1.05); }
  70% { transform: scale(0.9); }
  100% { transform: scale(1); opacity: 1; }
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
}

.no-more-text {
  font-size: 28rpx;
  color: #999999;
}

/* 悬浮创建按钮 */
.floating-create {
  position: fixed;
  bottom: 200rpx;
  right: 32rpx;
  z-index: 1000;
}

.create-btn {
  width: 120rpx !important;
  height: 120rpx !important;
  border-radius: 60rpx !important;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.4) !important;
  border: none !important;
}

.create-btn::after {
  border: none !important;
}

/* 自定义图标样式 */
.custom-components {
  display: none;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .artwork-list {
    padding: 24rpx;
  }
  
  .artwork-item {
    padding: 24rpx;
  }
  
  .artwork-image {
    height: 320rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .home-container {
    background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
  }
  
  .artwork-item {
    background: rgba(52, 73, 94, 0.9);
    border-color: rgba(255, 255, 255, 0.1);
  }
  
  .username {
    color: #ffffff;
  }
  
  .prompt-text {
    color: #bdc3c7;
  }
  
  .action-text {
    color: #95a5a6;
  }
  
  .no-more-text {
    color: #95a5a6;
  }
}
