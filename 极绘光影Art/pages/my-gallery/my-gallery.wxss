/* pages/my-gallery/my-gallery.wxss */
.gallery-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-top: 200rpx;
}

/* 顶部信息栏 */
.top-bar {
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.top-bar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 192rpx;
  padding: 0 32rpx;
}

.top-bar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

/* 头部操作栏 */
.header-actions {
  background: #ffffff;
  padding: 24rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid #f0f0f0;
}

.filter-tabs {
  display: flex;
  gap: 32rpx;
}

.filter-tab {
  font-size: 28rpx;
  color: #999999;
  padding: 12rpx 0;
  position: relative;
  transition: all 0.3s ease;
}

.filter-tab.active {
  color: #0052D9;
  font-weight: 600;
}

.filter-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: #0052D9;
  border-radius: 2rpx;
}

.header-buttons {
  display: flex;
  gap: 16rpx;
}

/* 作品网格 */
.artworks-grid {
  height: calc(100vh - 200rpx);
  padding: 32rpx;
}

.artwork-item {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.artwork-item:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
}

.artwork-image-container {
  position: relative;
  aspect-ratio: 1;
}

.artwork-image {
  width: 100%;
  height: 100%;
}

/* 状态标签 */
.status-tag {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  backdrop-filter: blur(10rpx);
}

.status-tag.public {
  background: rgba(34, 197, 94, 0.8);
  color: #ffffff;
}

.status-tag.private {
  background: rgba(156, 163, 175, 0.8);
  color: #ffffff;
}

.status-text {
  font-size: 20rpx;
  font-weight: 500;
}

/* 作品操作按钮 */
.artwork-actions {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  gap: 8rpx;
  opacity: 0;
  transition: all 0.3s ease;
}

.artwork-item:hover .artwork-actions,
.artwork-item:active .artwork-actions {
  opacity: 1;
}

.action-btn {
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.action-btn:active {
  background: rgba(0, 0, 0, 0.8);
  transform: scale(0.95);
}

.action-btn.delete {
  background: rgba(239, 68, 68, 0.8);
}

.action-btn.delete:active {
  background: rgba(239, 68, 68, 1);
}

/* 作品信息 */
.artwork-info {
  padding: 24rpx;
}

.artwork-prompt {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.artwork-stats {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-text {
  font-size: 22rpx;
  color: #666666;
}

.create-time {
  font-size: 22rpx;
  color: #999999;
}

/* 加载更多 */
.loading-more {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

.no-more {
  text-align: center;
  padding: 40rpx;
}

.no-more-text {
  font-size: 28rpx;
  color: #999999;
}

/* 自定义组件隐藏 */
.custom-components {
  display: none;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .artworks-grid {
    padding: 24rpx;
  }
  
  .artwork-item {
    margin-bottom: 24rpx;
  }
  
  .artwork-info {
    padding: 20rpx;
  }
  
  .filter-tabs {
    gap: 24rpx;
  }
  
  .filter-tab {
    font-size: 26rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .gallery-container {
    background: #2c3e50;
  }
  
  .header-actions,
  .artwork-item {
    background: #34495e;
  }
  
  .header-actions {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  
  .filter-tab {
    color: #bdc3c7;
  }
  
  .filter-tab.active {
    color: #3498db;
  }
  
  .filter-tab.active::after {
    background: #3498db;
  }
  
  .artwork-prompt {
    color: #ffffff;
  }
  
  .stat-text {
    color: #bdc3c7;
  }
  
  .create-time,
  .no-more-text {
    color: #95a5a6;
  }
}
