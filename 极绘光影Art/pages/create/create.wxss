/* pages/create/create.wxss */
.create-container {
  min-height: 100vh;
  background: #ffffff;
  padding: 200rpx 32rpx 32rpx;
}

/* 顶部信息栏 */
.top-bar {
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.top-bar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 192rpx;
  padding: 0 32rpx;
}

.top-bar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

/* 输入区域 */
.input-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.clear-btn:active {
  background: #e5e5e5;
  transform: scale(0.95);
}

/* 输入框包装器 */
.input-wrapper {
  margin-bottom: 32rpx;
}

/* 提示词输入框 */
.prompt-input {
  border-radius: 16rpx !important;
  border: 2rpx solid #e5e5e5 !important;
  padding: 24rpx !important;
  font-size: 28rpx !important;
  line-height: 1.5 !important;
  min-height: 120rpx !important;
}

.prompt-input:focus {
  border-color: #0052D9 !important;
}

/* 标签区域 */
.tags-section {
  margin-bottom: 32rpx;
}

.tags-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
  display: block;
}

.tags-container {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  padding: 12rpx 24rpx;
  background: #f5f5f5;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #666666;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  cursor: pointer;
}

.tag-item.selected {
  background: #0052D9;
  color: #ffffff;
  border-color: #0052D9;
}

.tag-item:active {
  transform: scale(0.95);
}

/* 负面提示词区域 */
.negative-section {
  margin-bottom: 0;
}

.negative-title {
  font-size: 28rpx;
  color: #666666;
  margin-bottom: 16rpx;
  display: block;
}

/* 负面提示词输入框 */
.negative-input {
  border-radius: 16rpx !important;
  border: 2rpx solid #e5e5e5 !important;
  padding: 20rpx 24rpx !important;
  font-size: 28rpx !important;
}

.negative-input:focus {
  border-color: #0052D9 !important;
}

/* 生成按钮区域 */
.generate-section {
  margin-bottom: 32rpx;
}

.generate-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s ease;
  margin: 0 auto;
}

.generate-btn.disabled {
  background: #cccccc;
  box-shadow: none;
}

.generate-btn:active:not(.disabled) {
  transform: translateY(-2rpx);
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.4);
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

/* 进度区域 */
.progress-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
}

.progress-header {
  text-align: center;
  margin-bottom: 24rpx;
}

.progress-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.progress-text {
  font-size: 24rpx;
  color: #999999;
}

.progress-bar {
  width: 100%;
  height: 8rpx;
  background: #f0f0f0;
  border-radius: 4rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx;
  transition: width 0.5s ease;
}

.progress-percent {
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #0052D9;
}

/* 结果区域 */
.result-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
  animation: slideInUp 0.6s ease-out;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.result-header {
  margin-bottom: 24rpx;
}

.result-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.image-container {
  position: relative;
  margin-bottom: 24rpx;
}

.result-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.image-actions {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
}

.action-btn {
  background: rgba(0, 0, 0, 0.5) !important;
  border: none !important;
  color: #ffffff !important;
  backdrop-filter: blur(10rpx) !important;
  display: flex !important;
  align-items: center !important;
  gap: 8rpx !important;
  padding: 8rpx 16rpx !important;
  font-size: 24rpx !important;
}

.action-btn::after {
  border: none !important;
}

.result-actions {
  display: flex;
  gap: 24rpx;
}

.result-actions .action-btn {
  flex: 1;
  height: 80rpx;
  background: transparent !important;
  border: 2rpx solid #e5e5e5 !important;
  color: #666666 !important;
  font-size: 28rpx !important;
}

.result-actions .action-btn:last-child {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  border-color: transparent !important;
  color: #ffffff !important;
}

/* 灵感示例区域 */
.inspiration-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
}

.inspiration-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 24rpx;
  display: block;
}

.examples-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.example-item {
  text-align: center;
  transition: all 0.3s ease;
}

.example-item:active {
  transform: scale(0.95);
}

.example-image {
  width: 100%;
  height: 120rpx;
  margin-bottom: 12rpx;
  border-radius: 12rpx;
}

.example-title {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
}

/* 自定义组件隐藏 */
.custom-components {
  display: none;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .create-container {
    padding: 24rpx;
  }
  
  .input-section,
  .progress-section,
  .result-section,
  .inspiration-section {
    padding: 24rpx;
  }
  
  .result-image {
    height: 320rpx;
  }
  
  .examples-grid {
    gap: 16rpx;
  }
  
  .example-image {
    height: 100rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .create-container {
    background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
  }
  
  .input-section,
  .progress-section,
  .result-section,
  .inspiration-section {
    background: rgba(52, 73, 94, 0.9);
    border-color: rgba(255, 255, 255, 0.1);
  }
  
  .section-title,
  .progress-title,
  .result-title,
  .inspiration-title {
    color: #ffffff;
  }
  
  .tags-title,
  .negative-title {
    color: #bdc3c7;
  }
  
  .progress-text {
    color: #95a5a6;
  }
  
  .example-title {
    color: #bdc3c7;
  }
}
