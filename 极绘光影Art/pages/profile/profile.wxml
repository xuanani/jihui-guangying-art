<!--pages/profile/profile.wxml-->
<view class="profile-container">
  <!-- 顶部白色信息栏 -->
  <view class="top-bar">
    <view class="top-bar-content">
      <text class="top-bar-title">个人中心</text>
    </view>
  </view>
  <!-- 未登录状态 -->
  <view class="login-section" wx:if="{{!isLoggedIn}}">
    <view class="login-content">
      <view class="login-avatar">
        <t-icon name="user" size="80rpx" color="#CCCCCC"></t-icon>
      </view>
      <text class="login-title">欢迎来到极绘光影</text>
      <text class="login-subtitle">登录后可以管理你的个人画廊和设置</text>
      
      <t-button
        theme="primary"
        size="large"
        shape="round"
        bind:tap="onWeChatLogin"
        class="wechat-login-btn"
      >
        <t-icon name="wechat" size="32rpx" color="#ffffff"></t-icon>
        <text>微信一键登录</text>
      </t-button>
    </view>
  </view>

  <!-- 已登录状态 -->
  <view class="user-section" wx:if="{{isLoggedIn}}">
    <!-- 用户信息头部 - 毛玻璃圆角效果 -->
    <view class="user-header-glass">
      <view class="user-info-container">
        <t-avatar
          image="{{userInfo.avatar}}"
          size="160rpx"
          bind:tap="changeAvatar"
          class="user-avatar"
        ></t-avatar>
        
        <view class="user-details">
          <text class="username">{{userInfo.nickname}}</text>
          <text class="user-id">ID: {{userInfo.userId}}</text>
          
          <!-- 个人简介 -->
          <text class="user-bio">{{userInfo.bio}}</text>
          
          <view class="user-stats">
            <view class="stat-item">
              <text class="stat-number">{{stats.artworks}}</text>
              <text class="stat-label">作品</text>
            </view>
            <view class="stat-item">
              <text class="stat-number">{{stats.likes}}</text>
              <text class="stat-label">获赞</text>
            </view>
            <view class="stat-item">
              <text class="stat-number">{{stats.fans}}</text>
              <text class="stat-label">粉丝</text>
            </view>
          </view>
        </view>
      </view>
      
      <t-button
        theme="primary"
        size="medium"
        shape="round"
        bind:tap="onEditProfile"
        class="edit-btn"
      >
        编辑资料
      </t-button>
    </view>
  </view>

  <!-- 内容区域 -->
  <view class="content-section">
    <!-- 个人画廊 -->
    <view class="gallery-section">
      <view class="section-header">
        <text class="section-title">个人画廊</text>
      </view>
      
      <view class="artworks-grid" wx:if="{{myArtworks.length > 0}}">
        <view
          class="artwork-item"
          wx:for="{{myArtworks}}"
          wx:key="id"
          bind:tap="onViewArtwork"
          data-id="{{item.id}}"
        >
          <t-image
            class="artwork-image"
            src="{{item.image}}"
            mode="aspectFill"
            shape="round"
            radius="12rpx"
            loading="lazy"
          ></t-image>
        </view>
        
        <!-- 添加作品按钮 -->
        <view class="add-artwork" bind:tap="onCreate">
          <t-icon name="add" size="48rpx" color="#CCCCCC"></t-icon>
        </view>
      </view>
      
      <t-empty wx:if="{{myArtworks.length === 0 && isLoggedIn}}" description="还没有作品，快去创作吧" icon="image">
        <t-button theme="primary" size="medium" bind:tap="onCreate">开始创作</t-button>
      </t-empty>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-section">
      <view class="menu-group">
        <view
          class="menu-item"
          wx:for="{{menuItems}}"
          wx:key="id"
          bind:tap="onMenuItemTap"
          data-id="{{item.id}}"
        >
          <view class="menu-icon" style="background-color: {{item.bgColor}};">
            <t-icon name="{{item.icon}}" size="32rpx" color="{{item.iconColor}}"></t-icon>
          </view>
          <text class="menu-title">{{item.title}}</text>
          <t-icon name="chevron-right" size="24rpx" color="#CCCCCC"></t-icon>
        </view>
      </view>
    </view>

    <!-- 设置菜单 -->
    <view class="settings-section">
      <text class="settings-title">设置</text>
      <view class="menu-group">
        <view
          class="menu-item"
          wx:for="{{settingsItems}}"
          wx:key="id"
          bind:tap="onSettingsItemTap"
          data-id="{{item.id}}"
        >
          <view class="menu-icon" style="background-color: {{item.bgColor}};">
            <t-icon name="{{item.icon}}" size="32rpx" color="{{item.iconColor}}"></t-icon>
          </view>
          <text class="menu-title">{{item.title}}</text>
          <t-icon name="chevron-right" size="24rpx" color="#CCCCCC"></t-icon>
        </view>
      </view>
    </view>
  </view>


</view>

<!-- 自定义组件引用 -->
<view class="custom-components">
  <t-icon name="user" size="24rpx" color="#CCCCCC"></t-icon>
  <t-icon name="wechat" size="24rpx" color="#ffffff"></t-icon>
  <t-icon name="chevron-right" size="24rpx" color="#0052D9"></t-icon>
  <t-icon name="add" size="24rpx" color="#CCCCCC"></t-icon>
  <t-icon name="heart" size="24rpx" color="#FF4757"></t-icon>
  <t-icon name="chat" size="24rpx" color="#2ED573"></t-icon>
  <t-icon name="download" size="24rpx" color="#9C88FF"></t-icon>
  <t-icon name="lock-on" size="24rpx" color="#FFA502"></t-icon>
  <t-icon name="info-circle" size="24rpx" color="#FF6B6B"></t-icon>
  <t-icon name="logout" size="24rpx" color="#95A5A6"></t-icon>
</view>
