/* pages/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
  padding-top: 200rpx;
}

/* 顶部信息栏 */
.top-bar {
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.top-bar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 192rpx;
  padding: 0 32rpx;
}

.top-bar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

/* 登录区域 */
.login-section {
  padding: 80rpx 32rpx;
  text-align: center;
}

.login-content {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  backdrop-filter: blur(20rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.login-avatar {
  width: 160rpx;
  height: 160rpx;
  background: #f5f5f5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.login-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.login-subtitle {
  font-size: 28rpx;
  color: #666666;
  display: block;
  margin-bottom: 48rpx;
  line-height: 1.5;
}

.wechat-login-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #07C160 0%, #00B050 100%) !important;
  border: none !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 16rpx !important;
  box-shadow: 0 8rpx 32rpx rgba(7, 193, 96, 0.3) !important;
}

.wechat-login-btn::after {
  border: none !important;
}

/* 用户信息头部 - 毛玻璃效果 */
.user-section {
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.user-header-glass {
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 32rpx;
  padding: 48rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.user-info-container {
  display: flex;
  align-items: flex-start;
  gap: 32rpx;
  margin-bottom: 32rpx;
}

.user-avatar {
  border: 6rpx solid #ffffff;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  border-radius: 16rpx;
}

.user-details {
  flex: 1;
}

.username {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #999999;
  display: block;
  margin-bottom: 16rpx;
}

.user-bio {
  font-size: 28rpx;
  color: #666666;
  display: block;
  margin-bottom: 24rpx;
  line-height: 1.6;
  word-break: break-word;
}

.user-stats {
  display: flex;
  gap: 48rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  text-align: center;
}

.stat-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

.edit-btn {
  width: 100%;
  font-size: 28rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  color: #ffffff !important;
  border: none !important;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
}

.edit-btn::after {
  border-color: rgba(255, 255, 255, 0.3) !important;
}

/* 内容区域 */
.content-section {
  padding: 0 32rpx 32rpx;
}

/* 画廊区域 */
.gallery-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.view-all-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0;
}

.view-all-text {
  font-size: 28rpx;
  color: #0052D9;
}

.artworks-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
}

.artwork-item {
  aspect-ratio: 1;
  border-radius: 12rpx;
  overflow: hidden;
  transition: all 0.3s ease;
}

.artwork-item:active {
  transform: scale(0.95);
}

.artwork-image {
  width: 100%;
  height: 100%;
}

.add-artwork {
  aspect-ratio: 1;
  background: #f5f5f5;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #cccccc;
  transition: all 0.3s ease;
}

.add-artwork:active {
  background: #e5e5e5;
  transform: scale(0.95);
}

/* 菜单区域 */
.menu-section,
.settings-section {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  border: 1rpx solid #f0f0f0;
}

.settings-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 24rpx;
}

.menu-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 0;
  transition: all 0.3s ease;
}

.menu-item:active {
  background: rgba(0, 0, 0, 0.05);
  border-radius: 12rpx;
  margin: 0 -16rpx;
  padding: 24rpx 16rpx;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-title {
  font-size: 28rpx;
  color: #333333;
  flex: 1;
}

/* 关注区域 */
.follow-section {
  padding: 32rpx;
  padding-top: 0;
}

.follow-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important;
  border: none !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3) !important;
}

.follow-btn::after {
  border: none !important;
}

/* 自定义组件隐藏 */
.custom-components {
  display: none;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .content-section {
    padding: 24rpx;
  }
  
  .gallery-section,
  .menu-section,
  .settings-section {
    padding: 24rpx;
  }
  
  .artworks-grid {
    gap: 16rpx;
  }
  
  .user-stats {
    gap: 32rpx;
  }
  
  .stat-number {
    font-size: 28rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .profile-container {
    background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
  }
  
  .login-content,
  .gallery-section,
  .menu-section,
  .settings-section {
    background: rgba(52, 73, 94, 0.9);
    border-color: rgba(255, 255, 255, 0.1);
  }
  
  .login-title {
    color: #ffffff;
  }
  
  .login-subtitle {
    color: #bdc3c7;
  }
  
  .section-title,
  .settings-title {
    color: #ffffff;
  }
  
  .menu-title {
    color: #ffffff;
  }
  
  .add-artwork {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }
}
