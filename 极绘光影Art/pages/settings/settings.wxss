/* pages/settings/settings.wxss */
.settings-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 200rpx 32rpx 32rpx;
}

/* 顶部信息栏 */
.top-bar {
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.top-bar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 192rpx;
  padding: 0 32rpx;
}

.top-bar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

/* 关于页面头部 */
.about-header {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  text-align: center;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.app-logo {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 16rpx;
}

.app-version {
  font-size: 28rpx;
  color: #666666;
  display: block;
  margin-bottom: 8rpx;
}

.app-build {
  font-size: 24rpx;
  color: #999999;
  display: block;
}

/* 设置区域 */
.settings-section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 24rpx;
}

.settings-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  transition: all 0.3s ease;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item:active {
  background: rgba(0, 0, 0, 0.05);
  border-radius: 12rpx;
  margin: 0 -16rpx;
  padding: 24rpx 16rpx;
}

.setting-info {
  flex: 1;
  min-width: 0;
}

.setting-name {
  font-size: 28rpx;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.setting-desc {
  font-size: 24rpx;
  color: #999999;
  line-height: 1.4;
}

/* 反馈弹窗 */
.feedback-popup {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow-y: auto;
}

.feedback-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.feedback-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333333;
}

.feedback-content {
  margin-bottom: 32rpx;
}

.feedback-input {
  margin-bottom: 24rpx;
}

.contact-input {
  margin-bottom: 0;
}

.feedback-actions {
  display: flex;
  gap: 24rpx;
}

.feedback-actions .t-button {
  flex: 1;
}

/* 自定义组件隐藏 */
.custom-components {
  display: none;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .settings-container {
    padding: 24rpx;
  }
  
  .settings-section,
  .about-header {
    padding: 24rpx;
  }
  
  .feedback-popup {
    width: 90vw;
    padding: 24rpx;
  }
  
  .app-logo {
    width: 120rpx;
    height: 120rpx;
  }
  
  .app-name {
    font-size: 40rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .settings-container {
    background: #2c3e50;
  }
  
  .settings-section,
  .about-header,
  .feedback-popup {
    background: #34495e;
  }
  
  .app-name,
  .section-title,
  .setting-name,
  .feedback-title {
    color: #ffffff;
  }
  
  .app-version,
  .app-build,
  .setting-desc {
    color: #bdc3c7;
  }
  
  .setting-item {
    border-bottom-color: rgba(255, 255, 255, 0.1);
  }
  
  .setting-item:active {
    background: rgba(255, 255, 255, 0.1);
  }
}
