/* pages/artwork-detail/artwork-detail.wxss */
.detail-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 顶部信息栏 */
.top-bar {
  background: rgba(255, 255, 255, 0.8);
  box-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.06);
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
}

.top-bar-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 192rpx;
  padding: 0 32rpx;
}

.top-bar-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
}

/* 图片区域 */
.image-section {
  position: relative;
  background: #ffffff;
  margin-bottom: 16rpx;
  padding-top: 200rpx;
}

.artwork-image {
  width: 100%;
  height: 60vh;
  min-height: 500rpx;
}

.image-actions {
  position: absolute;
  top: 32rpx;
  right: 32rpx;
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.action-btn:active {
  background: rgba(0, 0, 0, 0.7);
  transform: scale(0.95);
}

/* 作品信息 */
.info-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
}

.user-details {
  flex: 1;
  min-width: 0;
}

.username {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.create-time {
  font-size: 24rpx;
  color: #999999;
}

.action-buttons {
  display: flex;
  gap: 32rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.action-item:active {
  background: rgba(0, 0, 0, 0.05);
  transform: scale(0.95);
}

.action-item.liked {
  animation: heartBeat 0.6s ease-in-out;
}

@keyframes heartBeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}

.action-item.collected {
  animation: bounceIn 0.6s ease-in-out;
}

@keyframes bounceIn {
  0% { transform: scale(0.3); opacity: 0; }
  50% { transform: scale(1.05); }
  70% { transform: scale(0.9); }
  100% { transform: scale(1); opacity: 1; }
}

.action-count {
  font-size: 24rpx;
  color: #666666;
}

/* 提示词区域 */
.prompt-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.prompt-content,
.negative-prompt {
  margin-bottom: 24rpx;
}

.prompt-label {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  display: block;
  margin-bottom: 8rpx;
}

.prompt-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
  word-break: break-all;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.prompt-tag {
  margin: 0 !important;
}

/* 评论区域 */
.comments-section {
  background: #ffffff;
  padding: 32rpx;
  margin-bottom: 16rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  cursor: pointer;
}

.comments-list {
  margin-bottom: 24rpx;
}

.comment-item {
  display: flex;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.comment-item:last-child {
  margin-bottom: 0;
}

.comment-content {
  flex: 1;
  min-width: 0;
}

.comment-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.comment-user {
  font-size: 26rpx;
  font-weight: 600;
  color: #333333;
}

.comment-time {
  font-size: 22rpx;
  color: #999999;
}

.comment-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  margin-bottom: 12rpx;
  display: block;
}

.comment-actions {
  display: flex;
  align-items: center;
}

.comment-like {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.comment-like:active {
  background: rgba(0, 0, 0, 0.05);
}

.comment-like.liked {
  color: #FF4757;
}

.like-count {
  font-size: 22rpx;
  color: #666666;
}

.add-comment {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.comment-input {
  flex: 1;
}

/* 分享弹窗 */
.share-popup {
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
}

.share-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  text-align: center;
  display: block;
  margin-bottom: 32rpx;
}

.share-options {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 32rpx;
}

.share-option {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
}

.share-option:active {
  background: rgba(0, 0, 0, 0.05);
  transform: scale(0.95);
}

.share-label {
  font-size: 24rpx;
  color: #666666;
}

/* 自定义组件隐藏 */
.custom-components {
  display: none;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .info-section,
  .prompt-section,
  .comments-section {
    padding: 24rpx;
  }
  
  .artwork-image {
    height: 50vh;
    min-height: 400rpx;
  }
  
  .action-buttons {
    gap: 24rpx;
  }
  
  .action-item {
    padding: 12rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .detail-container {
    background: #2c3e50;
  }
  
  .image-section,
  .info-section,
  .prompt-section,
  .comments-section {
    background: #34495e;
  }
  
  .username,
  .section-title,
  .prompt-text,
  .comment-user,
  .comment-text,
  .share-title {
    color: #ffffff;
  }
  
  .create-time,
  .prompt-label,
  .comment-time,
  .action-count,
  .like-count,
  .share-label {
    color: #bdc3c7;
  }
  
  .share-popup {
    background: #34495e;
  }
  
  .share-option:active {
    background: rgba(255, 255, 255, 0.1);
  }
}
